# Copy values into the service environment on the EC2 instance; do not commit real secrets.
PIXEL_FORENSICS_ENV=production
PIXEL_FORENSICS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PIXEL_FORENSICS_ALLOWED_HOSTS=pixel.forensic.dpdns.org
PIXEL_FORENSICS_TTL_SECONDS=600
PIXEL_FORENSICS_MAX_UPLOAD_BYTES=20971520
PIXEL_FORENSICS_MAX_IMAGE_PIXELS=20000000
PIXEL_FORENSICS_MAX_MODULES_PER_RUN=44
PIXEL_FORENSICS_MAX_SESSION_ARTIFACT_BYTES=157286400
