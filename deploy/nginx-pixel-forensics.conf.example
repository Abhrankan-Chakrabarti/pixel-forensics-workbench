# Example only: install inside Nginx's http context (for example, conf.d).
# Replace the hostname and certificate paths with the values configured on EC2.
limit_req_zone $binary_remote_addr zone=pixel_api:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=pixel_conn:10m;

server {
    listen 80;
    server_name pixel.forensic.dpdns.org;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name pixel.forensic.dpdns.org;

    ssl_certificate     /etc/letsencrypt/live/pixel.forensic.dpdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pixel.forensic.dpdns.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;

    client_max_body_size 21m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    keepalive_timeout 20s;
    limit_conn pixel_conn 10;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    location /api/ {
        limit_req zone=pixel_api burst=8 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 240s;
        proxy_read_timeout 240s;
        proxy_request_buffering on;
    }

    location /artifacts/ {
        limit_req zone=pixel_api burst=12 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
